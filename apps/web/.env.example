# Shared
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Shopify Storefront API — Sales channels → Headless → storefront → Storefront API.
# Domain is the *.myshopify.com one, without https://. Private token is server-only.
# Products, cart and checkout all run through this; nothing sells without it.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-04
# Signing secret shown when a webhook is created (Settings → Notifications → Webhooks).
# Lets Shopify purge the product cache at /api/revalidate. Optional.
SHOPIFY_WEBHOOK_SECRET=

# Email (Resend — https://resend.com)
# Use onboarding@resend.dev for test sends; set a verified domain address for production.
RESEND_API_KEY=
EMAIL_FROM=Infuse & Muse <onboarding@resend.dev>

# Where /api/contact delivers. Without it the form returns 503 and sends nothing.
CONTACT_INBOX=
# Address shown on the contact, privacy, terms and shipping pages.
NEXT_PUBLIC_CONTACT_EMAIL=
