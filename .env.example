# ─── Required for any deploy ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://infuse-and-muse.vercel.app

# Gate. Unset or any value other than "off" redirects the whole site to
# /waitlist. Set to "off" for the owner demo so the storefront is reachable.
WAITLIST_MODE=off

# ─── Stripe (required for checkout) ───────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
# From `stripe listen` locally, or the Vercel webhook endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ─── Email (required for waitlist, contact form, order confirmations) ─────
RESEND_API_KEY=re_xxxxx
# Verified sender. "onboarding@resend.dev" works for testing only.
EMAIL_FROM=onboarding@resend.dev
# Where the contact form delivers.
CONTACT_INBOX=hello@infuseandmuse.ca
# Optional: Resend audience for the waitlist; falls back to a local JSON file.
RESEND_AUDIENCE_ID=

# ─── Sanity (optional — demo data is used when unset) ─────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# ─── Business details ─────────────────────────────────────────────────────
NEXT_PUBLIC_BUSINESS_NAME=Infuse & Muse
NEXT_PUBLIC_BUSINESS_CITY=Mississauga
NEXT_PUBLIC_BUSINESS_REGION=ON
NEXT_PUBLIC_BUSINESS_COUNTRY=CA
NEXT_PUBLIC_CONTACT_EMAIL=hello@infuseandmuse.ca
NEXT_PUBLIC_CONTACT_PHONE=+1 905-555-0189
